{
  "name": "botcompute",
  "version": "1.0.0",
  "description": "BotCompute - Decentralized compute marketplace and escrow protocol running on BOT Chain Mainnet",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:botchain": "hardhat run scripts/deploy.ts --network botchainMainnet",
    "seed:botchain": "hardhat run scripts/seed.ts --network botchainMainnet",
    "worker": "npm run --prefix worker start",
    "worker:dev": "npm run --prefix worker dev",
    "frontend:dev": "npm run --prefix frontend dev",
    "frontend:build": "npm run --prefix frontend build"
  },
  "keywords": [
    "botchain",
    "compute",
    "marketplace",
    "escrow",
    "solidity",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.10",
    "chai": "^4.3.7",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.18",
    "hardhat-gas-reporter": "^2.2.2",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.2"
  }
}
